#!/usr/bin/env bash
set -euo pipefail

# Enforce clean tree before push so each completed change is committed.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Push blocked: working tree is not clean. Commit your changes first."
  exit 1
fi

if [[ -x "./mvnw" ]]; then
  echo "Running tests before push..."
  ./mvnw -q test
fi

if [[ -f "./frontend/package.json" ]]; then
  echo "Running frontend build before push..."
  (cd frontend && npm ci >/dev/null 2>&1 && npm run build >/dev/null 2>&1)
fi

echo "Pre-push checks passed."
